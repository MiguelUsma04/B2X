# ---- Enrichment providers ----
# Prospeo: header X-KEY  (https://prospeo.io/api-docs)
PROSPEO_API_KEY=

# Icypeas: header Authorization, solo la API KEY (https://api-doc.icypeas.com)
ICYPEAS_API_KEY=

# Hunter: query param api_key (https://hunter.io/api-keys)
HUNTER_API_KEY=

# ---- GoHighLevel ----
# Private Integration Token (empieza con pit-)
GHL_API_TOKEN=
# ID del sub-account. Settings > Business Profile, o en la URL del dashboard.
GHL_LOCATION_ID=
# Tag que se agrega a cada contacto enviado
GHL_DEFAULT_TAG=piloto-prospeccion

# ---- Enrichment tuning ----
ENRICH_DELAY_SECONDS=1.0
ENRICH_MAX_RETRIES=3
ONLY_VERIFIED_EMAIL=false

# ---- Seguridad (obligatorio para exponer la app a internet) ----
# Contraseña única de acceso. Sin esto, la app SOLO acepta conexiones locales.
APP_PASSWORD=
# Clave para firmar la cookie de sesión. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Poné false SOLO si accedés por HTTP sin certificado (no recomendado).
COOKIE_SECURE=true
