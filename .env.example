# ---- Enrichment providers ----
# Prospeo: header X-KEY  (https://prospeo.io/api-docs)
PROSPEO_API_KEY=

# Icypeas: header Authorization, solo la API KEY (https://api-doc.icypeas.com)
ICYPEAS_API_KEY=

# Hunter: query param api_key (https://hunter.io/api-keys)
HUNTER_API_KEY=

# ---- GoHighLevel ----
# Private Integration Token (empieza con pit-)
GHL_API_TOKEN=
# ID del sub-account. Settings > Business Profile, o en la URL del dashboard.
GHL_LOCATION_ID=
# Tag que se agrega a cada contacto enviado
GHL_DEFAULT_TAG=piloto-prospeccion
# Embudo y etapa donde se crea la oportunidad de cada contacto enviado.
# Se eligen desde la app (Revisar y enviar > Oportunidades); estas variables
# son el valor inicial. Vacío = no se crean oportunidades.
GHL_PIPELINE_ID=
GHL_STAGE_ID=

# ---- Google Maps ----
# Places API (New). Necesita, en el MISMO proyecto de la key:
#   1) facturación activada, 2) 'Places API (New)' habilitada,
#   3) si la key restringe APIs, que esa esté en la lista.
GOOGLE_MAPS_API_KEY=

# ---- IA (lectura del sitio del negocio) ----
# OpenAI. La key sale de platform.openai.com/api-keys y necesita credito
# cargado en esa cuenta: la suscripcion de ChatGPT no da acceso a la API.
OPENAI_API_KEY=
# Modelo a usar. Cambiarlo es la palanca de costo/calidad.
OPENAI_MODEL=gpt-5-nano
# Escribir el correo es otra cosa que leer un sitio: con el nano,
# seis de cada diez salían copiando el brief adentro del correo.
OPENAI_MODEL_REDACCION=gpt-5-mini
# --- Lo que se lee de cada sitio -------------------------------------------
# El recorrido va por el sitio entero, con tres topes. Bajarlos hace todo mas
# barato y mas rapido, a cambio de saber menos de cada empresa.
SITIO_MAX_PAGINAS=40
SITIO_MAX_TEXTO=60000
SITIO_MAX_SEGUNDOS=75
# El nano no sirve para esto ni con poco texto: medido contra el mismo sitio,
# con 2.700 tokens devuelve el gancho vacio y la especialidad en 'otro'. El
# mini saca el gancho, las novedades y seis ciudades. Lo que abarata no es
# el modelo sino no repetir: cada frase se guarda una sola vez.
OPENAI_MODEL_FICHA=gpt-5-mini
# Esfuerzo de razonamiento. 'minimal' alcanza para extraer y es lo mas
# barato; los modelos que no razonan ignoran esta linea.
OPENAI_EFFORT=minimal

# ---- Enrichment tuning ----
ENRICH_DELAY_SECONDS=1.0
ENRICH_MAX_RETRIES=3
ONLY_VERIFIED_EMAIL=false

# ---- Ingresar con Google ----
# Credenciales OAuth 2.0 (tipo "Aplicacion web") del proyecto de Google Cloud.
# En la consola hay que registrar la URI de retorno EXACTA, por ejemplo:
#   http://localhost:8077/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo entran las cuentas de este dominio. Sin esto, no entra nadie por Google.
GOOGLE_ALLOWED_DOMAIN=gmarketing.co
# Invitados sueltos fuera del dominio, separados por coma. Normalmente vacio.
GOOGLE_ALLOWED_EMAILS=
# Detras de un proxy la app ve http aunque el usuario entre por https, y ahi
# Google rechaza el retorno. Si pasa, fijar la URL completa aca.
OAUTH_REDIRECT_URL=

# ---- Identidad y horario del envio ----
# Quien manda. Va en el pie de cada correo: un correo comercial sin remitente
# identificable es lo que un filtro de spam busca, y en varios paises ademas
# es obligatorio.
EMPRESA_NOMBRE=gmarketing.co
EMPRESA_DIRECCION=
# Entre que horas sale el correo (hora local del servidor). Fuera de esa
# franja el goteo espera; no descarta nada.
ENVIO_DESDE=8
ENVIO_HASTA=19
ENVIO_FIN_DE_SEMANA=false

# ---- Correos escritos por IA ----
# Cuantos caracteres puede tener el cuerpo. Con 300 aterriza entre 280 y 340
# en espanol; en ingles se estira un poco mas.
CORREO_MAX_CARACTERES=500
# Y el piso: el brief pide entre 350 y 500. Menos que eso no da para los
# cuatro tramos.
CORREO_MIN_CARACTERES=350
# Que ofrecemos, en dos lineas. Es lo unico que la IA no puede deducir del
# sitio del prospecto.
PROPUESTA_B2K=
# Para forzar un idioma en todos los correos (es, en, pt, fr, it, de).
# Vacio = el del pais de cada empresa.
IDIOMA_FORZADO=
IDIOMA_POR_DEFECTO=es

# ---- Kommo (CRM destino de los contactos) ----
# El subdominio es lo que va antes de .kommo.com
KOMMO_SUBDOMAIN=
# Token de larga duracion: Ajustes > Integraciones > tu integracion >
# Claves y scopes > Generar token de larga duracion.
KOMMO_TOKEN=
# A que embudo y etapa caen los contactos. Vacio = el embudo principal.
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=
# El responsable de cada lead en Kommo. 6346610 es
# soporte@gmarketing.co. Sin esto los leads entran sin dueño y no
# le aparecen a nadie en su lista.
KOMMO_RESPONSIBLE_ID=6346610
KOMMO_DEFAULT_TAG=b2k
# Indicativo del pais para los numeros sin prefijo. WhatsApp no encuentra un
# numero sin el: 3001234567 no existe, +573001234567 si.
KOMMO_COUNTRY_CODE=57

# ---- Medicion de los correos ----
# La direccion por la que se llega a B2K desde internet. Se escribe adentro
# de cada correo, asi que tiene que ser la publica y no la que ve el servidor
# detras del proxy. Sin esto no se miden aperturas ni clics: mejor un correo
# sin metricas que uno con enlaces rotos.
#   PUBLIC_URL=https://b2k.gmarketing.co
PUBLIC_URL=https://b2k.gmarketing.co

# ---- Seguridad (obligatorio para exponer la app a internet) ----
# Contraseña única de acceso. Sin esto, la app SOLO acepta conexiones locales.
APP_PASSWORD=
# Clave para firmar la cookie de sesión. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Poné false SOLO si accedés por HTTP sin certificado (no recomendado).
COOKIE_SECURE=true
