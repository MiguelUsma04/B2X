# ---- Enrichment providers ----
# Prospeo: header X-KEY  (https://prospeo.io/api-docs)
PROSPEO_API_KEY=

# Icypeas: header Authorization, solo la API KEY (https://api-doc.icypeas.com)
ICYPEAS_API_KEY=

# Hunter: query param api_key (https://hunter.io/api-keys)
HUNTER_API_KEY=

# ---- GoHighLevel ----
# Private Integration Token (empieza con pit-)
GHL_API_TOKEN=
# ID del sub-account. Settings > Business Profile, o en la URL del dashboard.
GHL_LOCATION_ID=
# Tag que se agrega a cada contacto enviado
GHL_DEFAULT_TAG=piloto-prospeccion
# Embudo y etapa donde se crea la oportunidad de cada contacto enviado.
# Se eligen desde la app (Revisar y enviar > Oportunidades); estas variables
# son el valor inicial. Vacío = no se crean oportunidades.
GHL_PIPELINE_ID=
GHL_STAGE_ID=

# ---- Google Maps ----
# Places API (New). Necesita, en el MISMO proyecto de la key:
#   1) facturación activada, 2) 'Places API (New)' habilitada,
#   3) si la key restringe APIs, que esa esté en la lista.
GOOGLE_MAPS_API_KEY=

# ---- IA (lectura del sitio del negocio) ----
# OpenAI. La key sale de platform.openai.com/api-keys y necesita credito
# cargado en esa cuenta: la suscripcion de ChatGPT no da acceso a la API.
OPENAI_API_KEY=
# Modelo a usar. Cambiarlo es la palanca de costo/calidad.
OPENAI_MODEL=gpt-5-nano
# Esfuerzo de razonamiento. 'minimal' alcanza para extraer y es lo mas
# barato; los modelos que no razonan ignoran esta linea.
OPENAI_EFFORT=minimal

# ---- Enrichment tuning ----
ENRICH_DELAY_SECONDS=1.0
ENRICH_MAX_RETRIES=3
ONLY_VERIFIED_EMAIL=false

# ---- Ingresar con Google ----
# Credenciales OAuth 2.0 (tipo "Aplicacion web") del proyecto de Google Cloud.
# En la consola hay que registrar la URI de retorno EXACTA, por ejemplo:
#   http://localhost:8077/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo entran las cuentas de este dominio. Sin esto, no entra nadie por Google.
GOOGLE_ALLOWED_DOMAIN=gmarketing.co
# Invitados sueltos fuera del dominio, separados por coma. Normalmente vacio.
GOOGLE_ALLOWED_EMAILS=
# Detras de un proxy la app ve http aunque el usuario entre por https, y ahi
# Google rechaza el retorno. Si pasa, fijar la URL completa aca.
OAUTH_REDIRECT_URL=

# ---- Seguridad (obligatorio para exponer la app a internet) ----
# Contraseña única de acceso. Sin esto, la app SOLO acepta conexiones locales.
APP_PASSWORD=
# Clave para firmar la cookie de sesión. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Poné false SOLO si accedés por HTTP sin certificado (no recomendado).
COOKIE_SECURE=true
