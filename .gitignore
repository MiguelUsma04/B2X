.env
# El .env sin punto tambien: si se cuela en un commit, las keys quedan
# en el historial del repo publico aunque despues se borre el archivo.
env
*.env
data/*.db
data/*.db-journal
# Los respaldos son copias enteras de la base: los contactos, los buzones
# y sus contraseñas. Al repositorio no van nunca.
data/respaldos/
__pycache__/
*.pyc
.venv/
venv/
